# Copy to .env. Every setting is optional.

# Cloudflare Tunnel token (docker-compose.yml)
TUNNEL_TOKEN=

# Require Cloudflare Access on every request (recommended when exposed).
# Team domain from Zero Trust → Settings → Custom pages, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" of the Access application
CF_ACCESS_AUD=
# password (default): password sign-in, plus Access if configured
# access: Cloudflare Access is the only sign-in (Google, GitHub, one-time PIN…)
JARVIS_AUTH=password

# Trust X-Forwarded-*/CF-Connecting-IP headers. Only set this behind a proxy or tunnel.
JARVIS_TRUST_PROXY=

# Set the password at first start instead of using the setup code (remove it afterwards)
JARVIS_PASSWORD=

# 32-byte key for encrypting secrets (64 hex chars). Default: generated into the data directory.
JARVIS_SECRET_KEY=

# Days a sign-in lasts (sliding)
JARVIS_SESSION_DAYS=30

# Where to listen (Docker sets HOST=0.0.0.0) and where to keep data
HOST=127.0.0.1
PORT=8790
JARVIS_DATA=./data

# Allow the ChatGPT subscription through Codex CLI, which keeps a read-only shell tool (see SECURITY.md)
JARVIS_ALLOW_TOOL_CLIS=
